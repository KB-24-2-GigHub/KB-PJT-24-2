<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gighub.workplace.mapper.WorkplaceMapper">

    <!--
        radius_meters 와 status 는 Column DEFAULT에 기대지 않고 계약값을 직접 적습니다.
        DEFAULT에 맡기면 100m 고정과 최초 ACTIVE가 코드에서 사라지고, 나중에 DEFAULT가
        바뀌면 조용히 다른 값이 저장됩니다.
    -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO workplaces
        (owner_user_id, business_registration_number, name, representative_name,
         road_address, detail_address, phone, latitude, longitude,
         radius_meters, status)
        VALUES
        (#{ownerUserId}, #{businessRegistrationNumber}, #{name}, #{representativeName},
         #{roadAddress}, #{detailAddress}, #{phone}, #{latitude}, #{longitude},
         100.00, 'ACTIVE')
    </insert>

    <!--
        목록과 건수의 조회 조건입니다. 두 SQL이 갈라지면 마지막 Page가 비거나 총 건수가
        실제와 달라지므로 한 곳에 두고 공유합니다.
    -->
    <sql id="ownedManageableWorkplaces">
        FROM workplaces
        WHERE owner_user_id = #{ownerUserId}
          AND status IN ('ACTIVE', 'INACTIVE')
    </sql>

    <!--
        latitude, longitude 는 승인된 목록 Item에 없으므로 SELECT 자체에서 뺍니다.
        정렬은 created_at 만으로는 같은 시각 등록에서 Page 사이 순서가 흔들릴 수 있어
        id 를 마지막 기준으로 더해 고정합니다.
    -->
    <select id="findPageByOwnerUserId" resultType="com.gighub.workplace.mapper.result.WorkplaceListRow">
        SELECT id AS workplace_id,
               business_registration_number,
               name,
               representative_name,
               road_address,
               detail_address,
               phone,
               radius_meters,
               status
        <include refid="ownedManageableWorkplaces"/>
        ORDER BY created_at DESC, id DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countByOwnerUserId" resultType="int">
        SELECT COUNT(*)
        <include refid="ownedManageableWorkplaces"/>
    </select>

    <!-- 온보딩 기준은 목록 기준과 달리 INACTIVE를 제외하고 현재 ACTIVE 사업장만 셉니다. -->
    <select id="countActiveByOwnerUserId" resultType="int">
        SELECT COUNT(*)
        FROM workplaces
        WHERE owner_user_id = #{ownerUserId}
          AND status = 'ACTIVE'
    </select>

    <!--
        고정 QR 은 ACTIVE 사업장에만 존재합니다. 상태 조건을 빼면 INACTIVE·DELETED 사업장의
        QR 까지 조회됩니다. 소유권 조건도 SQL 안에 두어야 다른 OWNER 의 사업장이 통과하지
        않습니다.
    -->
    <select id="countOwnedActiveById" resultType="int">
        SELECT COUNT(*)
        FROM workplaces
        WHERE id = #{workplaceId}
          AND owner_user_id = #{ownerUserId}
          AND status = 'ACTIVE'
    </select>

    <!--
        FOR UPDATE 로 사업장 행을 먼저 잠급니다. qr_tokens 만 잠그면 두 재발급이 서로 다른
        순서로 행을 잡아 교착할 수 있습니다. 소유권 확인도 같은 조회에서 끝내 잠금과 판정
        사이에 다른 요청이 끼어들지 않게 합니다.
    -->
    <select id="findOwnedActiveIdForUpdate" resultType="java.lang.Long">
        SELECT id
        FROM workplaces
        WHERE id = #{workplaceId}
          AND owner_user_id = #{ownerUserId}
          AND status = 'ACTIVE'
        FOR UPDATE
    </select>

    <resultMap id="workplaceLocationSnapshot"
               type="com.gighub.workplace.service.result.WorkplaceLocationSnapshot">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="latitude" javaType="java.math.BigDecimal"/>
            <arg column="longitude" javaType="java.math.BigDecimal"/>
        </constructor>
    </resultMap>

    <!--
        근태 스캔이 승인된 잠금 순서의 첫 단계로 사용합니다. 호출자는 사업장을 소유하지 않은
        WORKER이므로 소유자 조건을 두지 않고 활성 여부만 확인합니다.
    -->
    <select id="findActiveLocationForUpdate" resultMap="workplaceLocationSnapshot">
        SELECT id,
               latitude,
               longitude
        FROM workplaces
        WHERE id = #{workplaceId}
          AND status = 'ACTIVE'
        FOR UPDATE
    </select>

</mapper>
