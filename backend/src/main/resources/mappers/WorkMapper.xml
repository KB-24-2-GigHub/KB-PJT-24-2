<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gighub.work.mapper.WorkMapper">

    <!-- Write 판단 Row가 setter를 갖지 않으므로 생성자 인자로 매핑합니다. -->
    <resultMap id="workCaseEscrowContextResult"
               type="com.gighub.work.contract.WorkCaseEscrowSnapshot">
        <constructor>
            <idArg column="workCaseId" javaType="java.lang.Long"/>
            <arg column="employerId" javaType="java.lang.Long"/>
            <arg column="workerId" javaType="java.lang.Long"/>
            <arg column="agreedWage" javaType="java.lang.Long"/>
            <arg column="status" javaType="com.gighub.work.domain.WorkCaseStatus"/>
        </constructor>
    </resultMap>

    <select id="getEscrowContextForUpdate" resultMap="workCaseEscrowContextResult">
        SELECT id           AS workCaseId,
               employer_id  AS employerId,
               worker_id    AS workerId,
               agreed_wage  AS agreedWage,
               status       AS status
        FROM work_cases
        WHERE id = #{workCaseId}
        FOR UPDATE
    </select>

    <!-- 근무 건 상태 변경 -->
    <update id="updateWorkStatus">
        UPDATE work_cases
        SET status = #{toStatus}
        WHERE id = #{workCaseId}
        AND status IN
        <foreach item="s" collection="fromStatuses" open="(" separator="," close=")">
            #{s}
        </foreach>
    </update>

    <!-- work_cases 테이블에서 알바생 ID 가져오기 -->
    <select id="getWorkerIdByWorkCaseId" resultType="java.lang.Long">
        SELECT worker_id FROM work_cases WHERE id = #{workCaseId}
    </select>

    <!-- work_cases 테이블에서 약속된 임금(agreed_wage) 가져오기 -->
    <select id="getAgreedWageByWorkCaseId" resultType="java.lang.Long">
        SELECT agreed_wage FROM work_cases WHERE id = #{workCaseId}
    </select>

</mapper>
