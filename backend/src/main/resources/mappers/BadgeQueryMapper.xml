<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gighub.badge.mapper.BadgeQueryMapper">

    <!-- SQL 열을 Mapper 전용 Row의 불변 생성자에 명시적으로 연결합니다. -->
    <resultMap id="userBadgeRowResult" type="com.gighub.badge.mapper.result.UserBadgeRow">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="user_id" javaType="java.lang.Long"/>
            <arg column="badge_type" javaType="java.lang.String"/>
            <arg column="evidence" javaType="java.lang.String"/>
            <arg column="awarded_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <select id="findBadgesByUserId" resultMap="userBadgeRowResult">
        SELECT id, user_id, badge_type, evidence, awarded_at
        FROM user_badges
        WHERE user_id = #{userId}
        ORDER BY awarded_at DESC
    </select>

</mapper>
