VITE_API_BASE_URL=/api
DEV_PROXY_TARGET=http://localhost:8080

# Legacy Auth/User demo adapters only. RF-12 domain facades do not read this global flag.
VITE_USE_MOCK=false

# RF-12 facades use explicit operation-level mock selection in Development only.
# Examples: wallet.fetchWallet,workplaces.* or worker.scan
VITE_MOCK_OPERATIONS=
