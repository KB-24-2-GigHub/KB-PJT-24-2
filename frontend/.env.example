VITE_API_BASE_URL=/api
DEV_PROXY_TARGET=http://localhost:8080

# Dev server hosts allowed in addition to localhost, comma separated and without scheme.
# Only needed when reaching the dev server through an HTTPS tunnel, because camera and
# geolocation require a secure context on a real device. Keep it empty otherwise.
# Example: abcd-1-2-3-4.trycloudflare.com
DEV_ALLOWED_HOSTS=

# Legacy Auth/User demo adapters only. RF-12 domain facades do not read this global flag.
VITE_USE_MOCK=false

# RF-12 facades use explicit operation-level mock selection in Development only.
# Examples: wallet.fetchWallet,workplaces.* or worker.scan
VITE_MOCK_OPERATIONS=
